# Banco de dados
DATABASE_URL="postgresql://nexus:nexus@localhost:5432/nexus_erp?schema=public"

# App
PORT=3333
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_URL="redis://localhost:6379"

# Provedor fiscal (NF-e) - modo sandbox por padrao.
# Trocar FISCAL_PROVIDER para o adapter real quando houver credenciais de producao.
FISCAL_PROVIDER="sandbox"
FISCAL_API_KEY=""
FISCAL_API_URL=""
