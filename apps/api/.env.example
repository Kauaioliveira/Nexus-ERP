# Banco de dados
DATABASE_URL="postgresql://nexus:nexus@localhost:5432/nexus_erp?schema=public"

# App
PORT=3333
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis
REDIS_URL="redis://localhost:6379"

# Usuario admin inicial (rodar com: npm run prisma:seed --workspace=apps/api)
SEED_ADMIN_EMAIL="admin@nexuserp.local"
SEED_ADMIN_PASSWORD="TrocarEssaSenha123"
SEED_ADMIN_NAME="Administrador"

# Provedor fiscal (NF-e/NFC-e). "sandbox" = SEFAZ simulada em homologacao:
# gera numero, chave, XML 4.00 e QR Code, aplica as regras de rejeicao e o
# prazo de cancelamento, mas nada sai da maquina e nada tem valor fiscal.
# Os dados do emitente ficam em Configuracoes > Empresa e fiscal.
FISCAL_PROVIDER="sandbox"
FISCAL_SANDBOX_LATENCY_MS=300
FISCAL_API_KEY=""
FISCAL_API_URL=""

# Identificacao de produto pelo codigo de barras (cadastro).
# "openfoodfacts" (padrao, gratuito, sem chave) ou "off" para desligar.
BARCODE_LOOKUP="openfoodfacts"
# Opcional: token do Cosmos (cosmos.bluesoft.com.br), base brasileira que
# tambem devolve o NCM. Com ele, o Cosmos e consultado primeiro.
COSMOS_TOKEN=""
